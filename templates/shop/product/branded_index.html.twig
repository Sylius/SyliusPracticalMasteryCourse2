{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block content %}
    {% set brand = configuration.parameters.get('vars').brand %}
    <div class="card mb-3">
        <div class="card-header">
            <div class="card-title">
                {% for image in brand.getImagesByType('logo') %}
                    {% set path = image.path|imagine_filter(filter|default('sylius_brand_logo')) %}
                    <img src="{{ path }}" alt="{{ brand.name }}"
                {% endfor %}
                {{ brand.name }}
            </div>
        </div>
        <div class="card-body">
            {{ brand.description }}
        </div>
    </div>
    <div class="products-grid">
        {% for product in products %}
            {{ component('sylius_shop:product:card', { product: product, template: '@SyliusShop/product/common/card.html.twig'}) }}
        {% endfor %}
    </div>
{% endblock %}
