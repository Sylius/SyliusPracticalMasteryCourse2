{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}
    {{ 'sylius.email.brand_approval.subject'|trans({}, null, localeCode)|raw }}
{% endblock %}

{% block content %}
    {% set url = sylius_channel_url(path('sylius_shop_homepage', {'_locale': localeCode}), channel) %}

    <div style="text-align: center; margin-bottom: 30px;">
        <div style="font-size: 24px;">
            {{ 'sylius.email.brand_approval.greeting'|trans({'%brand_name%': brand.name}, null, localeCode) }}<br>
        </div>
        {{ 'sylius.email.brand_approval.body'|trans({'%brand_name%': brand.name}, null, localeCode) }}.
    </div>

    <div style="text-align: center;">
        {% set url = sylius_channel_url(path('sylius_shop_branded_products_index', {'_locale': localeCode, 'code': brand.code}), channel) %}
        <a href="{{ url|raw }}" style="display: inline-block; text-align: center; background: #1abb9c; padding: 18px 28px; color: #fff; text-decoration: none; border-radius: 3px;">
            {{ 'sylius.email.brand_approval.see_your_brand'|trans({}, null, localeCode) }}
        </a>
    </div>
{% endblock %}
